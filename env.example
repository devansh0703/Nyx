# LLM Backend Configuration (Google Gemini)
# Nyx runs on gemini-3.5-flash-lite via
# https://generativelanguage.googleapis.com/v1beta
# Get your API key from: https://aistudio.google.com/apikey (set GEMINI_API_KEY in ~/.bashrc
# — the app picks it up from the environment automatically.)
# GEMINI_API_KEY=your_gemini_api_key_here

# Output language for AI responses, meeting notes, summaries and action items.
OUTPUT_LANGUAGE=English

# Meeting audio language (used for transcription accuracy / context).
MEETING_AUDIO_LANGUAGE=auto

# ── Nyx parity settings ──────────────────────────────────────────────
# Invisibility: exclude overlay windows from screen shares/recordings (on|off).
# No-op on Linux (Electron limitation); works on macOS and Windows.
INVISIBILITY_MODE=on

# Auto launch with OS login (on|off). Also managed via Settings.
AUTO_LAUNCH=off

# Automatically start a listening session when a calendar meeting begins (true|false).
CALENDAR_AUTO_ATTEND=true

# Preferred display id for the overlay (from Settings → Change Display).
# PREFERRED_DISPLAY_ID=

# Keyboard shortcut overrides: set any SHORTCUT_<ID> to an Electron accelerator
# (e.g. CommandOrControl+Shift+9) or "disabled" to unbind it.
# IDs: SCREENSHOT, TOGGLEVISIBILITY, FORCEONTOP, SCREENASSIST, STEALTHANSWER,
# CLEARCONTEXT, TOGGLELIVEINSIGHTS, MOVELEFT, MOVERIGHT, TOGGLEINTERACTION,
# OPENCHAT, CLEARCONTEXT2, OPENSETTINGS, TOGGLEMIC, MOVEUP, MOVEDOWN
# SHORTCUT_SCREENASSIST=CommandOrControl+Return

# Gemini (gemini-3.5-flash-lite: text + vision + audio) is the AI backend —
# chat, screen vision, and ALL voice transcription run on it.
# Get a key: https://aistudio.google.com/apikey
# Set GEMINI_API_KEY in ~/.bashrc — the app picks it up from the environment.
# GEMINI_API_KEY=your_gemini_api_key_here
